---
import { SITE } from "../site"

interface Props {
	tone?: "navy" | "red"
}
const { tone = "navy" } = Astro.props
const stores = [
	{ name: "Google Play", href: SITE.googlePlay, icon: "play" },
	{ name: "App Store", href: SITE.appStore, icon: "phone" },
]
---

<div class="stores">
	{
		stores.map((s) => {
			const live = !!s.href
			const cls = live
				? tone === "red"
					? "button"
					: "button navy"
				: "button light"
			return (
				<a
					class={cls}
					href={live ? s.href : undefined}
					aria-disabled={live ? undefined : "true"}
					target={live ? "_blank" : undefined}
					rel={live ? "noopener" : undefined}>
					{s.icon === "play" ? (
						<svg viewBox="0 0 24 24" aria-hidden="true" aria-label={s.name}>
							<path
								fill="currentColor"
								d="M6 3.8v16.4c0 .8.9 1.3 1.6.9l13.1-8.2c.6-.4.6-1.3 0-1.7L7.6 2.9C6.9 2.5 6 3 6 3.8z"
							/>
						</svg>
					) : (
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<rect
								x="6"
								y="2"
								width="12"
								height="20"
								rx="3"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
							/>
							<circle cx="12" cy="18" r="1.3" fill="currentColor" />
						</svg>
					)}
					<span class="label">
						<small>{live ? "Get it on" : "Coming soon"}</small>
						{s.name}
					</span>
				</a>
			)
		})
	}
</div>
